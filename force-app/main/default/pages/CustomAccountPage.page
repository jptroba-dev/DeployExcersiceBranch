<apex:page controller="MyAccountController">
    <apex:pageBlock title="My Accounts">
    	<apex:pageBlockTable value="{!accountlist}" var="item"> <!-- es como un for loop -->
            <apex:column value="{!item.name}"/>  
            <apex:column value="{!item.Id}"/>   
            <apex:column value="{!item.CreatedDate}"/> 
        </apex:pageBlockTable>
    </apex:pageBlock>
</apex:page>